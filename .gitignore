node_modules/
.env

# User uploads (bills, order photos, product photos) stay out of git;
# only the empty folders are kept
/uploads/**
/src/uploads/**
!/uploads/**/
!/src/uploads/**/
!/uploads/**/.gitkeep
!/src/uploads/**/.gitkeep

# Applicant identity documents (phase 34): never in git, never public
/private-uploads/

# Security review 2026-10-30 (M-05): never commit secrets, keys, dumps or logs
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
*.dump
*.backup
*.sql.gz
*.log
logs/
