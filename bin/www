
/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('customer-backend:server');
var http = require('http');
var { Server } = require('socket.io');
var jwt = require('jsonwebtoken');
var db = require('../src/config/db');

/**
 * Get port from environment.
 * Ensure PORT=5000 in your .env file if your API uses port 5000.
 */

var port = normalizePort(
  process.env.PORT || '5000'
);

app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Create Socket.IO server.
 */

var allowedOrigins = app.get('allowedOrigins') || [];

var io = new Server(server, {
  cors: {
    // Same allow-list as the REST API; mobile apps send no Origin
    origin: function (origin, callback) {
      callback(null, !origin || allowedOrigins.includes(origin));
    },
    methods: [
      'GET',
      'POST',
      'PUT',
      'PATCH',
      'DELETE',
      'OPTIONS',
    ],
  },
});

/**
 * Make Socket.IO available to Express controllers.
 */

app.set('io', io);

/**
 * Shopper dispatch: every second, forward waiting orders to the next
 * closest shopper when due (5 s steps, 10 s per shopper).
 */

require('../src/controllers/shopperDispatch').startDispatchLoop(io);

/**
 * Offers that start / end on their own: tell customer apps to refetch.
 */

require('../src/utils/offerClock').startOfferClock(io);

// Shops with opening hours open / close on schedule (phase 27)
require('../src/utils/shopHoursClock').startShopHoursClock(io);

// Admin notifications: push committed events, time-based checks (phase 41)
require('../src/admin/notifications').startListener(io);
require('../src/admin/notifications').startClock();
// Support cases: first-response deadline alerts on the same clock (phase 43)
require('../src/support/supportCases').startOverdueCheck(io);
// Shopper document expiry alerts / auto-offline on the same clock (phase 46)
require('../src/compliance/documents').startComplianceCheck(io);

/**
 * Socket.IO authentication.
 */

io.use(function (socket, next) {
  try {
    const token = socket.handshake.auth?.token;

    if (!token) {
      console.error('❌ SOCKET AUTH: Token missing');
      return next(new Error('Authentication token is required'));
    }

    if (!process.env.JWT_SECRET) {
      console.error('❌ SOCKET AUTH: JWT_SECRET is not configured');
      return next(new Error('Server authentication is not configured'));
    }

    const decoded = jwt.verify(token, process.env.JWT_SECRET);

    const customerId =
      decoded?.customerId ??
      decoded?.customer_id ??
      null;

    const shopperId =
      decoded?.shopperId ??
      decoded?.shopper_id ??
      null;

    if (decoded?.adminId != null && decoded?.role === 'admin') {
      socket.admin = decoded;
      socket.userType = 'admin';
    } else if (decoded?.shopId != null) {
      socket.shop = decoded;
      socket.userType = 'shop';
    } else if (customerId !== null && customerId !== undefined) {
      socket.customer = decoded;
      socket.userType = 'customer';
    } else if (shopperId !== null && shopperId !== undefined) {
      socket.shopper = decoded;
      socket.userType = 'shopper';
    } else {
      console.error('❌ SOCKET AUTH: Unknown token type');
      return next(new Error('Invalid socket user'));
    }

    // Shopper tokens from before a phone change / recovery are refused
    // (phase 35, utils/shopperSession.js)
    if (socket.userType === 'shopper') {
      return require('../src/utils/shopperSession')
        .isSessionCurrent(decoded)
        .then((current) => {
          if (!current) return next(new Error('Session ended. Sign in again.'));
          console.log('🔐 SOCKET AUTH SUCCESS:', { type: socket.userType, customerId, shopperId });
          return next();
        })
        .catch(() => next(new Error('Unable to check the session')));
    }

    // Phase 44: a blocked customer account can't connect (same style
    // as the shopper session check; one primary-key lookup)
    if (socket.userType === 'customer') {
      return require('../src/config/db')
        .query('SELECT account_status FROM customers WHERE id = $1', [Number(customerId)])
        .then((result) => {
          if (result.rows[0]?.account_status === 'blocked') {
            const error = new Error('ACCOUNT_BLOCKED');
            error.data = { code: 'ACCOUNT_BLOCKED', message: 'Your GetMe account is blocked. Please contact GetMe support for help.' };
            return next(error);
          }
          console.log('🔐 SOCKET AUTH SUCCESS:', { type: socket.userType, customerId, shopperId });
          return next();
        })
        .catch(() => next(new Error('Unable to check the account')));
    }

    console.log('🔐 SOCKET AUTH SUCCESS:', {
      type: socket.userType,
      customerId,
      shopperId,
    });

    return next();
  } catch (error) {
    console.error('❌ SOCKET JWT ERROR:', error.message);
    return next(new Error('Invalid or expired token'));
  }
});

/**
 * Socket.IO connections and rooms.
 */

io.on('connection', function (socket) {
  const customerId =
    socket.customer?.customerId ??
    socket.customer?.customer_id ??
    socket.customer?.id ??
    null;

  const shopperId =
    socket.shopper?.shopperId ??
    socket.shopper?.shopper_id ??
    socket.shopper?.id ??
    null;

  console.log('🔌 Socket connected:', socket.id);

  console.log('👤 Socket user:', {
    type: socket.userType,
    customerId,
    shopperId,
  });

  /**
   * Automatically join customer room.
   */

  if (socket.userType === 'customer' && customerId != null) {
    const room = `customer:${customerId}`;
    socket.join(room);
    // Shop catalog changes (realtime.broadcastCatalogChange)
    socket.join('customers');
    console.log('🏠 Joined customer room:', room);
  }

  /**
   * Automatically join shopper room.
   */

  if (socket.userType === 'shopper' && shopperId != null) {
    const room = `shopper:${shopperId}`;
    socket.join(room);
    console.log('🏠 Joined shopper room:', room);
  }

  /**
   * Admin panel and shop websites.
   */

  if (socket.userType === 'admin') {
    // Phase 40: active account, current session version and the
    // permissions decide the rooms (a Developer gets no business events;
    // live map positions need liveops.view)
    socket.adminPermissions = new Set();
    socket.adminReady = db
      .query('SELECT role, is_active, auth_version, permission_grants, permission_revokes, must_change_password FROM admins WHERE id = $1', [socket.admin.adminId])
      .then((result) => {
        const row = result.rows[0];
        if (!row || !row.is_active || Number(socket.admin.av ?? 0) !== Number(row.auth_version || 0)) {
          socket.disconnect(true);
          return;
        }
        socket.adminPermissions = new Set(require('../src/admin/permissions').effectivePermissions(row));
        // Phase 41: own room + notification push (src/admin/notifications.js);
        // nothing until a temporary password has been replaced
        if (row.must_change_password) return null;
        return require('../src/admin/notifications')
          .attachSocket(socket, { adminId: Number(socket.admin.adminId), role: row.role || 'owner', permissions: socket.adminPermissions })
          .then(() => row);
      })
      .then((row) => {
        if (!row) return;
        if (socket.adminPermissions.has('dashboard.view')) {
          socket.join('admins');
          console.log('🏠 Joined admins room');
        }
        if (socket.adminPermissions.has('liveops.view')) {
          socket.join('admins:live');
        }
      })
      .catch((error) => console.error('❌ admin socket rooms error:', error.message));
  }

  if (socket.userType === 'shop') {
    const room = `shop:${socket.shop.shopId}`;
    socket.join(room);
    console.log('🏠 Joined shop room:', room);
  }

  /**
   * Join order room.
   * Only the order's customer, its shopper (or any shopper while the
   * order is still looking for one) and admins may listen to it.
   */

  socket.on('join-order', async function (orderId) {
    const numericOrderId = Number(orderId);

    if (!Number.isSafeInteger(numericOrderId) || numericOrderId <= 0) {
      console.warn('⚠️ SOCKET: Invalid order ID:', orderId);
      return;
    }

    try {
      if (socket.userType === 'admin') {
        await socket.adminReady;
        if (!socket.adminPermissions?.has('orders.view')) {
          console.warn('⚠️ SOCKET: admin without orders.view tried to join an order');
          return;
        }
      }

      if (socket.userType !== 'admin') {
        const result = await db.query(
          'SELECT customer_id, shopper_id, status FROM orders WHERE id = $1',
          [numericOrderId]
        );

        const order = result.rows[0];

        const allowed =
          order &&
          ((socket.userType === 'customer' &&
            Number(order.customer_id) === Number(customerId)) ||
            (socket.userType === 'shopper' &&
              (Number(order.shopper_id) === Number(shopperId) ||
                (order.shopper_id == null &&
                  order.status === 'waiting_for_shopper'))));

        if (!allowed) {
          console.warn('⚠️ SOCKET: join-order denied', {
            orderId: numericOrderId,
            userType: socket.userType,
          });
          return;
        }
      }
    } catch (error) {
      console.error('❌ SOCKET join-order check failed:', error.message);
      return;
    }

    const room = `order:${numericOrderId}`;

    socket.join(room);

    console.log('📦 Joined order room:', {
      socketId: socket.id,
      room,
      userType: socket.userType,
    });
  });

  /**
   * Leave order room.
   */

  socket.on('leave-order', function (orderId) {
    const numericOrderId = Number(orderId);

    if (!Number.isSafeInteger(numericOrderId) || numericOrderId <= 0) {
      console.warn('⚠️ SOCKET: Invalid order ID:', orderId);
      return;
    }

    const room = `order:${numericOrderId}`;

    socket.leave(room);

    console.log('🚪 Left order room:', {
      socketId: socket.id,
      room,
    });
  });

  /**
   * Connection errors.
   */

  socket.on('error', function (error) {
    console.error('❌ SOCKET CLIENT ERROR:', error.message);
  });

  /**
   * Disconnect.
   */

  socket.on('disconnect', function (reason) {
    console.log('🔌 Socket disconnected:', {
      socketId: socket.id,
      reason,
      userType: socket.userType,
      customerId,
      shopperId,
    });
  });
});

/**
 * Start HTTP and Socket.IO server.
 */

server.listen(port);

server.on('error', onError);

server.on('listening', onListening);

/**
 * Normalize a port.
 */

function normalizePort(val) {
  var parsedPort = parseInt(val, 10);

  if (isNaN(parsedPort)) {
    return val;
  }

  if (parsedPort >= 0) {
    return parsedPort;
  }

  return false;
}

/**
 * Server error handler.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind =
    typeof port === 'string'
      ? 'Pipe ' + port
      : 'Port ' + port;

  if (error.code === 'EACCES') {
    console.error(bind + ' requires elevated privileges');
    process.exit(1);
  }

  if (error.code === 'EADDRINUSE') {
    console.error(bind + ' is already in use');
    process.exit(1);
  }

  throw error;
}

/**
 * Listening handler.
 */

function onListening() {
  var addr = server.address();

  var bind =
    typeof addr === 'string'
      ? 'pipe ' + addr
      : 'port ' + addr.port;

  debug('Listening on ' + bind);

  console.log('🚀 Server listening on ' + bind);
  console.log('🔌 Socket.IO ready');
}

