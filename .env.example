PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=getme
DB_USER=postgres
DB_PASSWORD=

# Long random string. Changing it logs everyone out.
JWT_SECRET=

# Google Maps Platform key with Places API (New) + Routes API enabled
GOOGLE_MAPS_API_KEY=

# Web apps allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Seconds a new batch stays on a shopper's screen
SHOPPER_OFFER_SECONDS=60

# ---- Card payments (PayHere saved cards) ----
# test    = local stand-in for PayHere, fake charges (dev only; the default
#           when NODE_ENV isn't production). Test cards: 4916 2175 0161 1292
#           (Visa), 5307 7321 2553 1191 (Mastercard), 4000 0000 0000 0002 (declines)
# sandbox = sandbox.payhere.lk, live = www.payhere.lk
PAYHERE_MODE=test
# Merchant ID + the Merchant Secret for the domain in PUBLIC_API_URL
# (PayHere > Settings > Domains & Credentials)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# API key with the "Automated Charging API" permission (Settings > API Keys)
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
# Public HTTPS address of this server. PayHere posts card tokens to
# <PUBLIC_API_URL>/api/payments/payhere/notify, so it can't be a LAN IP
# (use ngrok / cloudflared in development)
PUBLIC_API_URL=
# Encrypts saved card tokens: 64 hex chars, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes saved cards unusable (customers add them again)
CARD_TOKEN_KEY=
